# ============ LLM 配置（推荐：硅基流动免费模型链，自动多模型兜底） ============
# 复制本文件为 .env 并填入你的 Key。
# 免费模型按顺序走，哪个 402/超时自动切下一个：DeepSeek-V4-Flash → Qwen3.5-27B → Nex-N2-Pro → Qwen3.5-35B-A3B → Qwen3.5-4B
SF_BASE_URL=https://api.siliconflow.cn/v1
SF_API_KEY=sk-你的key
# 可选：自定义模型链（逗号分隔，顺序即优先级）
# SF_MODELS=deepseek-ai/DeepSeek-V4-Flash,Qwen/Qwen3.5-27B,nex-agi/Nex-N2-Pro,Qwen/Qwen3.5-35B-A3B,Qwen/Qwen3.5-4B

# ---------- 旧渠道（DeepSeek 官方，仅当上面没配 SF_API_KEY 时才会启用，避免误扣费） ----------
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-chat

# 服务端口（默认 3025）
PORT=3025

# 面试题库目录（可选；默认使用项目内 interview-bank/）
# INTERVIEW_BANK_DIR=D:\\Shawn\\01_工作\\codeg\\接口自动化\\北梦测
